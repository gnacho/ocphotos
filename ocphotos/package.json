{
  "name": "web-app-ocphotos",
  "version": "1.6.1",
  "description": "Native OpenCloud web extension for the ocphotos photo experience",
  "license": "AGPL-3.0-only",
  "author": "gnacho",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm vite build",
    "build:w": "pnpm vite build --watch --mode development",
    "check:types": "vue-tsc --noEmit",
    "lint": "eslint 'src/**/*.{js,ts,vue}' --color",
    "check:overrides": "node scripts/check-overrides.mjs",
    "format:check": "prettier . --check",
    "format:write": "prettier . --write",
    "test:unit": "NODE_OPTIONS=--unhandled-rejections=throw vitest",
    "test:coverage": "NODE_OPTIONS=--unhandled-rejections=throw vitest run --coverage"
  },
  "devDependencies": {
    "@opencloud-eu/eslint-config": "^8.2.1",
    "@opencloud-eu/extension-sdk": "^8.2.1",
    "@opencloud-eu/prettier-config": "^8.2.1",
    "@opencloud-eu/tsconfig": "^8.2.1",
    "@opencloud-eu/web-client": "^8.2.1",
    "@opencloud-eu/web-pkg": "^8.2.1",
    "@types/leaflet": "^1.9.22",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^4.1.12",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.13",
    "vue3-gettext": "^4.0.0-beta.1"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  },
  "pnpm": {
    "overrides": {
      "axios": "^1.20.0",
      "adm-zip": "^0.6.1",
      "brace-expansion": "^5.0.12"
    }
  }
}
